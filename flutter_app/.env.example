# NVIDIA Build API Key — get one at https://build.nvidia.com/models
# Copy this file to `.env` (which is gitignored) and fill in your own key.
# Never commit a real key: `.env.example` is tracked by git.
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY_HERE

# Model identifier for deepfake / vision analysis
NVIDIA_MODEL_NAME=nvidia/neva-22b

# NOTE: There is deliberately no signing secret here.
# Since the HKDF migration the HMAC key is derived per-device from the
# hardware identifier and cached in the Keystore/Keychain — see
# SecurityService.hkdfSalt / hkdfInfo. Nothing cryptographic lives in .env.
