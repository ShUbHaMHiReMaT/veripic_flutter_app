# Copy to .env for local runs. On Render/Fly these go in the dashboard's
# environment settings instead — never in a file that gets committed.

# The Atlas connection string. This is the ONLY place it ever appears.
# Use a user scoped to readWrite on one database, not an admin user.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_DB=geoguard

# OAuth client id(s) from Google Cloud Console, comma-separated.
# Looks like 123456789-abcdef.apps.googleusercontent.com
# NOT an AIza... API key — that is a different kind of credential entirely.
#
# List every client id the app might present (Web, Android, iOS). A token is
# accepted only if its `aud` is one of these, so listing your own project's
# clients is safe while a token from any other project is still refused.
GOOGLE_WEB_CLIENT_ID=210844702277-hjcm8h360gvcun6om7vk5ftareb78fab.apps.googleusercontent.com

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

PORT=8080

# Razorpay. The KEY ID is public and also goes in the app; the SECRET must
# never leave this server — it is what proves a payment really happened.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# From Razorpay Dashboard > Settings > Webhooks. Grants payments where the
# user closed the app mid-redirect.
RAZORPAY_WEBHOOK_SECRET=
